# Packaged defaults; native library roots follow java_home.
# Installed code is read-only; downloaded content and settings remain in /data.
java_home=/app0/runtimes/jdk17
jar=/app0/runtimes/jdk17/lib/orbis/graphics/lib/orbis-launcher.jar
working_directory=/data/orbis-jdk/minecraft
output_log=/data/orbis-jdk/runner/runner-output.log
temporary_directory=/data/orbis-jdk/runner/tmp
debug=false
display=gpu
version_metadata=/app0/manifests/launcher.json
libraries=/data/orbis-jdk/libraries
