+/* ⚠ THE PS4's GEOMETRY STAGE WRITES PAST THE GSVS RING SIZE IT IS GIVEN, so on Orbis that ring's buffer
+ * is allocated larger than the size its descriptor and VGT_GSVS_RING_SIZE declare. RADV measured it first
+ * (radv_orbis_gs_ring_bytes): buffer == declared size faults off the end - "GPU Protection fault, client
+ * TC, access Write, Unmapped page access". On the Pro (graphics-probe GeometryProbe) a 1 MiB GSVS ring
+ * with no padding faulted exactly 1 MiB in, and 4x padding holds every test; the ESGS ring never faulted
+ * unpadded. So ORBIS_GS_RING_PAD (GSVS, default 4) and ORBIS_GS_RING_PAD_ESGS (default 1), the total
+ * capped at ORBIS_GS_RING_PAD_CAP_MB (256). A ring larger than the cap alone is never shrunk. */
+static unsigned si_orbis_gs_ring_alloc(unsigned size, bool is_esgs)
+{
+#ifdef HAVE_ORBIS_PLATFORM
+   static int pad = -1, esgs_pad = -1, cap_mb = -1;
+   if (pad < 0) {
+      pad = MAX2((int)debug_get_num_option("ORBIS_GS_RING_PAD", 4), 1);
+      esgs_pad = MAX2((int)debug_get_num_option("ORBIS_GS_RING_PAD_ESGS", 1), 1);
+      cap_mb = MAX2((int)debug_get_num_option("ORBIS_GS_RING_PAD_CAP_MB", 256), 0);
+      mesa_logi("radeonsi/orbis: GS ring buffers allocated GSVS %dx / ESGS %dx their declared size, total "
+                "capped at %d MiB - the hardware writes past the GSVS size it is given", pad, esgs_pad, cap_mb);
+   }
+   if (is_esgs)
+      return (unsigned)MIN2((uint64_t)size * (unsigned)esgs_pad,
+                            MAX2((uint64_t)size, (uint64_t)cap_mb << 20));
+   const uint64_t ceiling = MAX2((uint64_t)size, (uint64_t)cap_mb << 20);
+   return (unsigned)MIN3((uint64_t)size * (unsigned)pad, ceiling, (uint64_t)UINT32_MAX & ~255ull);
+#else
+   (void)is_esgs;
+   return size;
+#endif
+}
