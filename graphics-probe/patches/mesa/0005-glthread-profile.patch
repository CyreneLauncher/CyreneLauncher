+/* Orbis glthread profile: every ~5 s the render thread reports how long it waited for queue
+ * space (add_job), for the worker in _mesa_glthread_finish, and executing leftovers itself;
+ * plus the worker's busy time and its most expensive commands. TSC is calibrated once. */
+static double orbis_tsc_per_ms;
+
+static void
+orbis_glthread_report(struct glthread_state *glthread)
+{
+   uint64_t now = __rdtsc();
+   if (!glthread->prof_window_start) {
+      glthread->prof_window_start = now;
+      return;
+   }
+   if (orbis_tsc_per_ms == 0) {
+      struct timespec a, b;
+      clock_gettime(CLOCK_MONOTONIC, &a);
+      uint64_t t0 = __rdtsc();
+      do clock_gettime(CLOCK_MONOTONIC, &b);
+      while ((b.tv_sec - a.tv_sec) * 1000000000LL + (b.tv_nsec - a.tv_nsec) < 2000000);
+      orbis_tsc_per_ms = (double)(__rdtsc() - t0) /
+         (((b.tv_sec - a.tv_sec) * 1000000000LL + (b.tv_nsec - a.tv_nsec)) / 1e6);
+   }
+   double window_ms = (now - glthread->prof_window_start) / orbis_tsc_per_ms;
+   if (window_ms < 5000)
+      return;
+   int top[8];
+   for (int k = 0; k < 8; k++) {
+      top[k] = -1;
+      for (int i = 0; i < 2048; i++) {
+         bool taken = false;
+         for (int j = 0; j < k; j++) taken |= top[j] == i;
+         if (!taken && glthread->prof_cmd_ticks[i] &&
+             (top[k] < 0 || glthread->prof_cmd_ticks[i] > glthread->prof_cmd_ticks[top[k]]))
+            top[k] = i;
+      }
+   }
+   char cmds[768];
+   int used = 0;
+   for (int k = 0; k < 8 && top[k] >= 0; k++)
+      used += snprintf(cmds + used, sizeof(cmds) - used, " %d:%.0fms/%u", top[k],
+                       glthread->prof_cmd_ticks[top[k]] / orbis_tsc_per_ms,
+                       glthread->prof_cmd_count[top[k]]);
+   used += snprintf(cmds + used, sizeof(cmds) - used, "; syncs by call:");
+   for (int i = 0; i < 16 && glthread->prof_sync_func[i]; i++) {
+      if (glthread->prof_sync_count[i])
+         used += snprintf(cmds + used, sizeof(cmds) - used, " %s=%u",
+                          glthread->prof_sync_func[i], glthread->prof_sync_count[i]);
+      glthread->prof_sync_count[i] = 0;
+   }
+   mesa_logi("glthread profile over %.0f ms: render thread waited %.0f ms for queue space, "
+             "%.0f ms in %" PRIu64 " finishes (+%.0f ms running leftovers); worker busy %.0f ms "
+             "over %" PRIu64 " batches; top worker cmds (id:time/count):%s",
+             window_ms, glthread->prof_add_job_wait / orbis_tsc_per_ms,
+             glthread->prof_finish_wait / orbis_tsc_per_ms, glthread->prof_finishes,
+             glthread->prof_finish_direct / orbis_tsc_per_ms,
+             glthread->prof_worker_busy / orbis_tsc_per_ms, glthread->prof_batches, cmds);
+   glthread->prof_window_start = now;
+   glthread->prof_add_job_wait = glthread->prof_finish_wait = glthread->prof_finish_direct = 0;
+   glthread->prof_worker_busy = glthread->prof_batches = glthread->prof_finishes = 0;
+   memset(glthread->prof_cmd_ticks, 0, sizeof(glthread->prof_cmd_ticks));
+   memset(glthread->prof_cmd_count, 0, sizeof(glthread->prof_cmd_count));
+}
