@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef RADV_ORBIS_METADATA_H
+#define RADV_ORBIS_METADATA_H
+#include <stdbool.h>
+#include <stdlib.h>
+
+/* Gladius loses half the drawn 8x8 tiles after a CMASK clear (radeonsi patch 0041).
+ * Keep this safety gate ahead of FORCE_COMPRESS and the generic ORBIS_CMASK probe.
+ * Only the same explicit opt-in as radeonsi permits experiments on NEO. */
+static inline bool
+radv_orbis_color_metadata_enabled(int family)
+{
+   if (family != CHIP_GLADIUS)
+      return true;
+   const char *want = getenv("ORBIS_FAST_CLEAR");
+   return want && want[0] == '1' && want[1] == '\0';
+}
+#endif
