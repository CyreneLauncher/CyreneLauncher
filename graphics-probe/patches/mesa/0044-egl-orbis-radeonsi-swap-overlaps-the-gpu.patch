+/* ⚠ THE SWAP DOES NOT WAIT FOR THE GPU. It used to: flush, wait for the whole frame, flip, return - so the CPU sat
+ * idle while the GPU finished frame N, and the GPU then sat idle while the CPU built the start of frame N+1. The
+ * two never worked at once. Now the swap flushes, hands the frame's fence to the FLIPPER THREAD and returns; the
+ * flipper waits for the GPU, flips, and waits for the flip to reach the screen. Every video-out call is the
+ * flipper's while it runs.
+ *
+ * THREE BUFFERS STILL DO, because the CPU may get only one frame ahead. A job is finished when its frame is ON
+ * SCREEN, and the swap posts frame N only once frame N-1's job is finished - so N-1 is displayed, N is the
+ * flipper's, and the buffer handed out for N+1 is N-2's, which the display has let go of. No added latency: a
+ * frame flips when the GPU finishes it, as before.
+ *
+ * ORBIS_SWAP_OVERLAP=0 restores the waiting swap. */
+struct orbis_gl_flip_job {
+   void *fence; /* dri2_fence of the frame, or NULL: then the flip waits for the GPU to go idle */
+   struct dri_screen *screen;
+   unsigned index;
+   uint64_t swap_ns; /* when the swap posted it */
+};
