+#define ORBIS_GL_STATS_FRAMES 600
+#define ORBIS_GL_WAIT_NS (2ull * 1000 * 1000 * 1000)
+
+static bool
+orbis_gl_overlap_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = debug_get_bool_option("ORBIS_SWAP_OVERLAP", true) ? 1 : 0;
+   return enabled == 1;
+}
+
+/* One frame onto the screen: its GPU work, then the flip, then - when `wait_shown` - until the display shows it.
+ * The waiting swap does not wait for the showing; it waited for the previous flip before queueing instead. */
+static void
+orbis_gl_flip(struct orbis_gl_window *w, const struct orbis_gl_flip_job *job, bool wait_shown,
+              uint64_t *gpu_ns, uint64_t *shown_ns)
+{
+   /* The present waits for the GPU too. Given 0 it waits for the NEWEST submission, which with the swap no longer
+    * waiting is already the next frame's work - so it gets the label as it stands once this frame's fence has
+    * signalled: done by definition, and no wait at all. */
+   extern uint64_t ac_orbis_gpu_seq_retired(void);
+   uint64_t gpu_seq = 0;
+
+   const uint64_t t0 = os_time_get_nano();
+   if (job->fence) {
+      if (!dri_client_wait_sync(NULL, job->fence, 0, ORBIS_GL_WAIT_NS))
+         _eglLog(_EGL_WARNING, "orbis-egl: the frame did not finish within 2 s; flipping it anyway");
+      else
+         gpu_seq = ac_orbis_gpu_seq_retired();
+      dri_destroy_fence(job->screen, job->fence);
+   }
+   const uint64_t t1 = os_time_get_nano();
+
+   /* The previous flip on screen before this one is queued (see the block comment above). */
+   for (unsigned waited = 0; wsi_orbis_flips_pending(w->so) > 0 && waited < 100000; waited += 250)
+      usleep(250);
+
+   if (!wsi_orbis_scanout_present(w->so, job->index, w->addrs[job->index], w->pitch_px * 4, gpu_seq))
+      _eglLog(_EGL_WARNING, "orbis-egl: flip of buffer %u failed", job->index);
+
+   if (wait_shown) {
+      for (unsigned waited = 0; wsi_orbis_flips_pending(w->so) > 0 && waited < 100000; waited += 250)
+         usleep(250);
+   }
+
+   *gpu_ns = t1 - (job->swap_ns != 0 ? job->swap_ns : t0);
+   *shown_ns = os_time_get_nano() - t1;
+}
+
+static void *
+orbis_gl_flipper_main(void *arg)
+{
+   struct orbis_gl_window *w = arg;
+
+   pthread_mutex_lock(&w->lock);
+   for (;;) {
+      while (!w->job_pending && !w->stop)
+         pthread_cond_wait(&w->cond, &w->lock);
+      if (!w->job_pending)
+         break; /* stopping, and nothing left to show */
+      const struct orbis_gl_flip_job job = w->job;
+      w->job_pending = false;
+      pthread_mutex_unlock(&w->lock);
+
+      uint64_t gpu_ns, shown_ns;
+      orbis_gl_flip(w, &job, true, &gpu_ns, &shown_ns);
+
+      pthread_mutex_lock(&w->lock);
+      w->gpu_ns += gpu_ns;
+      w->shown_ns += shown_ns;
+      w->busy = false;
+      pthread_cond_broadcast(&w->cond);
+   }
+   pthread_mutex_unlock(&w->lock);
+   return NULL;
+}
+
+static void
+orbis_gl_flipper_start(struct orbis_gl_window *w)
+{
+   if (!orbis_gl_overlap_enabled()) {
+      mesa_logi("orbis-egl: ORBIS_SWAP_OVERLAP=0 - the swap waits for each frame before flipping it");
+      return;
+   }
+   pthread_mutex_init(&w->lock, NULL);
+   pthread_cond_init(&w->cond, NULL);
+   if (pthread_create(&w->flipper, NULL, orbis_gl_flipper_main, w) != 0) {
+      mesa_logw("orbis-egl: the flipper thread could not be created; the swap waits for each frame instead");
+      pthread_cond_destroy(&w->cond);
+      pthread_mutex_destroy(&w->lock);
+      return;
+   }
+   w->flipper_live = true;
+   mesa_logi("orbis-egl: frames flip from a thread of their own - the swap returns without waiting for the GPU");
+}
+
+/* Shows whatever is still posted, then joins. */
+static void
+orbis_gl_flipper_stop(struct orbis_gl_window *w)
+{
+   if (!w->flipper_live)
+      return;
+   pthread_mutex_lock(&w->lock);
+   w->stop = true;
+   pthread_cond_broadcast(&w->cond);
+   pthread_mutex_unlock(&w->lock);
+   pthread_join(w->flipper, NULL);
+   pthread_cond_destroy(&w->cond);
+   pthread_mutex_destroy(&w->lock);
+   w->flipper_live = false;
+}
