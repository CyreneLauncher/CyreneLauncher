+/* Capture a stalled final submission even when the application stops submitting.
+ * Separate snapshot lock: callers may already hold the submit lock. Never follow
+ * live GPU pointers from this dump; only read the CPU-owned saved stream. */
+static void
+orbis_dump_wait_stall(void)
+{
+   static unsigned reported;
+   static struct orbis_hung_slot capture;
+   if (!orbis_dump_hung_enabled() || p_atomic_read(&reported))
+      return;
+   const uint32_t label = *orbis_fence_label;
+   const uint64_t queued = p_atomic_read(&orbis_submit_seq_no);
+   if (p_atomic_cmpxchg(&reported, 0, 1) != 0)
+      return;
+   mesa_logw("orbis-drm: WAIT_STALL completed=%u queued=%" PRIu64,
+             label, queued);
+   if (label >= queued) {
+      mesa_logw("orbis-drm: WAIT_STALL has no unfinished submission; inspect sync payload lifecycle");
+      return;
+   }
+   const uint64_t pending = (uint64_t)label + 1;
+   simple_mtx_lock(&orbis_hung_snapshot_lock);
+   const struct orbis_hung_slot *hs = &orbis_hung_ring[pending % ORBIS_HUNG_RING];
+   if (hs->seq == pending && hs->dwords > 0 && hs->dwords <= ARRAY_SIZE(capture.stream)) {
+      capture.seq = hs->seq;
+      capture.dwords = hs->dwords;
+      memcpy(capture.stream, hs->stream, (size_t)hs->dwords * sizeof(uint32_t));
+   }
+   simple_mtx_unlock(&orbis_hung_snapshot_lock);
+   if (capture.seq == pending && capture.dwords > 0)
+      orbis_dump_ib(capture.seq, capture.stream, capture.dwords, "WAIT_STALL", false);
+   else
+      mesa_logw("orbis-drm: WAIT_STALL submit #%" PRIu64 " is absent from the %u-slot snapshot ring",
+                pending, ORBIS_HUNG_RING);
+}
 
