+#ifdef HAVE_ORBIS_PLATFORM
+/* ORBIS_TRACE_BUFMAP=1: which route each buffer map takes. ORBIS_BUFMAP_SIMPLE=1: every write map waits for
+ * the GPU and writes the buffer in place - no staging, no reallocation, no unsynchronized write. Both exist
+ * for the instancing bug: per-instance data the CPU rewrites every frame reaches the GPU wrong. */
+static int si_orbis_bufmap_trace(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("ORBIS_TRACE_BUFMAP");
+      on = e != NULL && e[0] == '1';
+   }
+   return on;
+}
+
+static int si_orbis_bufmap_simple(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("ORBIS_BUFMAP_SIMPLE");
+      on = e != NULL && e[0] == '1';
+      if (on)
+         mesa_logw("radeonsi/orbis: ORBIS_BUFMAP_SIMPLE - every buffer write waits for the GPU and maps directly");
+   }
+   return on;
+}
+
