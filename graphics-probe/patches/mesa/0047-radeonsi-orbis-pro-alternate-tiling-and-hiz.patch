+bool
+ac_orbis_alt_tiling(void)
+{
+   static int alt = -1;
+   if (alt < 0) {
+      const char *const e = getenv("ORBIS_ALT_TILING");
+      alt = 0;
+#if defined(__PS4__)
+      /* On in Neo mode; ORBIS_ALT_TILING=0 turns it off, which also turns HTILE off (si_pipe.c). */
+      if (sceKernelIsNeoMode() == 1 && !(e != NULL && strcmp(e, "0") == 0))
+         alt = 1;
+#else
+      (void)e;
+#endif
+      if (alt)
+         mesa_logi("orbis-drm: the Pro's alternate tiling (pipe config 18, Gnm's bank shapes) in the tile tables, "
+                   "addrlib and DB_DEPTH_INFO; ORBIS_ALT_TILING=0 turns it off");
+   }
+   return alt == 1;
+}
