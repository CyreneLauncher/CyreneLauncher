+   /* ⚠ THE PRO's ALTERNATE TILING, AS SONY'S OWN DRIVER WRITES IT. Gnm (read out of a retail title's static
+    * libSceGnm) keeps the same 32 tile modes with the Pro's pipe config in GB_TILE_MODE bits 27-31 - AMD's
+    * ALT_PIPE_CONFIG field - set to 18 in every entry, and the Pro's bank shape in GB_MACROTILE_MODE bits 8-13:
+    * ALT_BANK_HEIGHT, ALT_MACRO_TILE_ASPECT, ALT_NUM_BANKS. Its low bits are this table's. addrlib already
+    * knows the fields (CiLib, enableAltTiling); 18 itself is Sony's name for a 16-pipe layout, which ciaddrlib
+    * maps to P16_32x32_8x16, the reading shadPS4 uses.
+    *
+    * MEASURED (graphics-probe GeometryProbe, then Minecraft): it is what makes HTILE work on the Pro - without it
+    * HiZ corrupts most of the frame, with it depth testing is exact and Complementary went from 29-32 to 40 fps.
+    * It does NOT fix colour fast clears, which still lose half their drawn tiles with it (patch 0041 stays). */
+   if (ac_orbis_alt_tiling()) {
+      static const uint32_t gnm_macro_alt[16] = {0x26e8, 0x26d4, 0x21d0, 0x21d0, 0x2080, 0x2040, 0x1000, 0,
+                                                0x36ec, 0x26e8, 0x21d4, 0x20d0, 0x1080, 0x1040, 0, 0};
+      for (unsigned i = 0; i < 32; i++)
+         if (info->gb_tile_mode[i])
+            info->gb_tile_mode[i] |= 18u << 27;
+      for (unsigned i = 0; i < 16; i++)
+         info->gb_macro_tile_mode[i] |= gnm_macro_alt[i] & 0x3f00u;
+   }
