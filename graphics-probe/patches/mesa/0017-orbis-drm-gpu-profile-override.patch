+   /* From here neo_mode selects the Gladius PROFILE. ORBIS_GPU_PROFILE=liverpool|gladius overrides it for an
+    * A/B, e.g. Liverpool in Neo mode to tell Gladius programming apart from Neo mode itself. */
+   const int execution_neo = neo_mode;
+   const char *const profile_override = getenv("ORBIS_GPU_PROFILE");
+   if (profile_override != NULL) {
+      if (strcmp(profile_override, "liverpool") == 0) {
+         neo_mode = 0;
+      } else if (strcmp(profile_override, "gladius") == 0) {
+         neo_mode = 1;
+      } else {
+         mesa_loge("orbis-drm: ORBIS_GPU_PROFILE=%s must be liverpool or gladius", profile_override);
+         return -EINVAL;
+      }
+   }
 
