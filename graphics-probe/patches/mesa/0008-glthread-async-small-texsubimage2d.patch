index 07ac970..d9d756b 100644
--- a/src/mesa/glapi/glapi/gen/gl_API.xml
+++ b/src/mesa/glapi/glapi/gen/gl_API.xml
@@ -3358,7 +3358,7 @@
     </function>
 
     <function name="TexSubImage2D" es1="1.0" es2="2.0" no_error="true" exec="dlist"
-              marshal="async" marshal_sync="!_mesa_glthread_has_unpack_buffer(ctx)">
+              marshal="custom">
         <param name="target" type="GLenum"/>
