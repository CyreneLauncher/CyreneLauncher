diff --git a/src/gallium/drivers/radeonsi/si_pipe.c b/src/gallium/drivers/radeonsi/si_pipe.c
index 5a7607b..7dce599 100644
--- a/src/gallium/drivers/radeonsi/si_pipe.c
+++ b/src/gallium/drivers/radeonsi/si_pipe.c
@@ -214,6 +214,12 @@ static struct pipe_screen *radeonsi_screen_create_impl(struct radeon_winsys *ws,
 
    sscreen->debug_flags = debug_get_flags_option("R600_DEBUG", radeonsi_debug_options, 0);
    sscreen->debug_flags |= debug_get_flags_option("AMD_DEBUG", radeonsi_debug_options, 0);
+#ifdef HAVE_ORBIS_PLATFORM
+   /* No HTILE on a PS4 Pro: Sony enables it in Neo mode only for its own 16-pipe depth layout, and with
+    * ours depth tests fail tile by tile (see RADV's radv_physical_device.c). */
+   if (sscreen->info.family == CHIP_GLADIUS)
+      sscreen->debug_flags |= DBG(NO_HYPERZ);
+#endif
 
    if ((sscreen->debug_flags & DBG(TMZ)) &&
        !sscreen->info.has_tmz_support) {
diff --git a/src/gallium/drivers/radeonsi/si_state_draw.cpp b/src/gallium/drivers/radeonsi/si_state_draw.cpp
index 78b6b29..368a8fa 100644
--- a/src/gallium/drivers/radeonsi/si_state_draw.cpp
+++ b/src/gallium/drivers/radeonsi/si_state_draw.cpp
@@ -6,6 +6,9 @@
 
 #include "si_build_pm4.h"
 #include "ac_cmdbuf_cp.h"
+#ifdef HAVE_ORBIS_PLATFORM
+#include "ac_linux_drm.h"
+#endif
 
 #include "util/hash_table.h"
 #define XXH_INLINE_ALL
@@ -1237,6 +1240,14 @@ static void si_emit_ia_multi_vgt_param(struct si_context *sctx,
       radeon_opt_set_uconfig_reg_idx(R_030960_IA_MULTI_VGT_PARAM,
                                      AC_TRACKED_IA_MULTI_VGT_PARAM_UCONFIG,
                                      4, ia_multi_vgt_param);
+#ifdef HAVE_ORBIS_PLATFORM
+   } else if (GFX_VERSION == GFX7 && ac_orbis_ia_multi_vgt_uconfig()) {
+      /* A PS4 Pro in Neo mode reads it at its GFX9 address (see RADV's radv_emit_ia_multi_vgt_param);
+       * written as context 0x28AA8 the work distributor hangs with no wave launched. */
+      radeon_opt_set_uconfig_reg_idx(R_030960_IA_MULTI_VGT_PARAM,
+                                     AC_TRACKED_IA_MULTI_VGT_PARAM_UCONFIG,
+                                     4, ia_multi_vgt_param | (1u << 21) | (1u << 22));
+#endif
    } else if (GFX_VERSION >= GFX7) {
       radeon_opt_set_context_reg_idx(R_028AA8_IA_MULTI_VGT_PARAM,
                                      AC_TRACKED_IA_MULTI_VGT_PARAM, 1, ia_multi_vgt_param);
