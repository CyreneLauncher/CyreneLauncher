+
+static void
+orbis_gl_window_release(struct orbis_gl_window *w)
+{
+   if (w->so)
+      wsi_orbis_scanout_destroy(w->so);
+   for (unsigned i = 0; i < ORBIS_GL_BUFFERS; i++) {
+      if (w->images[i])
+         dri2_destroy_image(w->images[i]);
+   }
+   memset(w, 0, sizeof(*w));
+}
+
+static bool
+orbis_gl_window_init(struct dri2_egl_display *dri2_dpy, struct dri2_egl_surface *dri2_surf)
+{
+   struct orbis_gl_window *w = &orbis_gl_window;
+
+   if (w->so && w->surf == dri2_surf)
+      return true;
+   if (w->failed)
+      return false;
+   orbis_gl_window_release(w);
+   w->surf = dri2_surf;
+   for (unsigned i = 0; i < ORBIS_GL_BUFFERS; i++) {
+      w->images[i] = dri_create_image(dri2_dpy->dri_screen_render_gpu, dri2_surf->base.Width,
+                                      dri2_surf->base.Height, dri2_surf->visual, NULL, 0,
+                                      __DRI_IMAGE_USE_LINEAR | __DRI_IMAGE_USE_SCANOUT |
+                                         __DRI_IMAGE_USE_BACKBUFFER,
+                                      dri2_surf);
+      uint32_t pitch = 0;
+      if (!w->images[i] ||
+          !si_orbis_texture_cpu_address(w->images[i]->texture, &w->addrs[i], &pitch) ||
+          (i > 0 && pitch != w->pitch_px)) {
+         _eglLog(_EGL_WARNING, "orbis-egl: back buffer %u could not be created as a linear image", i);
+         goto fail;
+      }
+      w->pitch_px = pitch;
+   }
+
+   w->so = wsi_orbis_scanout_create(dri2_surf->base.Width, dri2_surf->base.Height, ORBIS_GL_BUFFERS,
+                                    w->addrs, w->pitch_px);
+   if (!w->so) {
+      _eglLog(_EGL_WARNING, "orbis-egl: video-out refused radeonsi's back buffers");
+      goto fail;
+   }
+   wsi_orbis_scanout_reserve(w->so, 1);
+   _eglLog(_EGL_INFO, "orbis-egl: radeonsi presents %u linear %ux%u buffers (pitch %u px) by flipping them",
+           ORBIS_GL_BUFFERS, dri2_surf->base.Width, dri2_surf->base.Height, w->pitch_px);
+   return true;
+
+fail:
+   orbis_gl_window_release(w);
+   w->failed = true;
+   return false;
+}
