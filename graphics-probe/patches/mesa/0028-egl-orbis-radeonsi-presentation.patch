+#ifdef HAVE_ORBIS_PLATFORM
+/* The CPU address and pitch of a linear 2D texture's level 0, for registering EGL's back buffers with
+ * video-out: the console scans out of memory the GPU renders into, and on Orbis every buffer the winsys
+ * hands out is mapped in the one arena, so this is the address itself, never a staging copy. */
+bool si_orbis_texture_cpu_address(struct pipe_resource *res, void **ptr, uint32_t *pitch_px);
+
+bool si_orbis_texture_cpu_address(struct pipe_resource *res, void **ptr, uint32_t *pitch_px)
+{
+   struct si_screen *sscreen = (struct si_screen *)res->screen;
+   struct si_texture *tex = (struct si_texture *)res;
+
+   if (res->target != PIPE_TEXTURE_2D || !tex->surface.is_linear || sscreen->info.gfx_level >= GFX9)
+      return false;
+
+   void *map = sscreen->ws->buffer_map(sscreen->ws, tex->buffer.buf, NULL,
+                                       PIPE_MAP_READ | PIPE_MAP_WRITE | PIPE_MAP_UNSYNCHRONIZED);
+   if (!map)
+      return false;
+
+   *ptr = (uint8_t *)map + (uint64_t)tex->surface.u.legacy.level[0].offset_256B * 256;
+   *pitch_px = tex->surface.u.legacy.level[0].nblk_x;
+   return true;
+}
+#endif
