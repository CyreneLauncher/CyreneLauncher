+}
+
+static EGLBoolean
+dri2_orbis_image_swap_buffers(_EGLDisplay *disp, _EGLSurface *draw)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(draw);
+   struct orbis_gl_window *w = &orbis_gl_window;
+
+   if (draw->Type != EGL_WINDOW_BIT || w->surf != dri2_surf || !w->so)
+      return EGL_TRUE;
+
+   dri2_flush_drawable_for_swapbuffers(disp, draw);
+
+   /* The previous flip on screen before this one is queued (see the block comment above). */
+   for (unsigned waited = 0; wsi_orbis_flips_pending(w->so) > 0 && waited < 100000; waited += 250)
+      usleep(250);
+
+   if (!wsi_orbis_scanout_present(w->so, w->back, w->addrs[w->back], w->pitch_px * 4, 0))
+      _eglLog(_EGL_WARNING, "orbis-egl: flip of buffer %u failed", w->back);
+
+   w->back = (w->back + 1) % ORBIS_GL_BUFFERS;
+   dri_invalidate_drawable(dri2_surf->dri_drawable);
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+dri2_orbis_image_swap_buffers_with_damage(_EGLDisplay *disp, _EGLSurface *draw, const EGLint *rects,
