diff --git a/src/gallium/drivers/radeonsi/si_buffer.c b/src/gallium/drivers/radeonsi/si_buffer.c
index 60ccac6..268a465 100644
--- a/src/gallium/drivers/radeonsi/si_buffer.c
+++ b/src/gallium/drivers/radeonsi/si_buffer.c
@@ -798,6 +798,14 @@ void si_copy_buffer(struct si_context *sctx, struct pipe_resource *dst, struct p
    if (!size)
       return;
 
+#ifdef HAVE_ORBIS_PLATFORM
+   /* CP DMA, never compute: compute writes on this console lose parts of their output (see the blit
+    * default in si_pipe.c). Sodium moves chunk geometry with buffer copies, and a garbled copy drew a black
+    * box at the camera whenever a chunk unloaded. */
+   si_cp_dma_copy_buffer(sctx, dst, src, dst_offset, src_offset, size);
+   return;
+#endif
+
    if (si_compute_clear_copy_buffer(sctx, dst, dst_offset, src, src_offset, size, NULL, 0, 0,
                                     false, true))
       return;
@@ -825,6 +833,15 @@ void si_clear_buffer(struct si_context *sctx, struct pipe_resource *dst,
    if (util_lower_clearsize_to_dword(clear_value, (int*)&clear_value_size, &clamped))
       clear_value = &clamped;
 
+#ifdef HAVE_ORBIS_PLATFORM
+   /* CP DMA whenever it can do the clear - see si_copy_buffer. Only unaligned clears and conditional ones
+    * still need compute. */
+   if (offset % 4 == 0 && size % 4 == 0 && clear_value_size == 4 && !render_condition_enable) {
+      si_cp_dma_clear_buffer(sctx, &sctx->gfx_cs, dst, offset, size, *clear_value);
+      return;
+   }
+#endif
+
    if (si_compute_clear_copy_buffer(sctx, dst, offset, NULL, 0, size, clear_value,
                                     clear_value_size, 0, render_condition_enable,
                                     method == SI_AUTO_SELECT_CLEAR_METHOD))
