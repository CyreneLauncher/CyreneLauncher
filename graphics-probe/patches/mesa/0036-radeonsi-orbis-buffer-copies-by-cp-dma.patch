@@ -792,16 +792,127 @@ static bool si_resource_commit(struct pipe_context *pctx, struct pipe_resource *
       return si_texture_commit(ctx, res, level, box, commit);
 }
 
+#ifdef HAVE_ORBIS_PLATFORM
+/* Buffer copies and clears by CP DMA rather than compute. Added when compute output seemed to lose parts:
+ * a black box Sodium drew at the camera on chunk unloads was blamed on garbled compute copies, but it was
+ * Flywheel's instancing bug, and compute blits have since tested clean. With compute buffer operations a
+ * compute probe stays clean, yet Minecraft's Mojang loading logo renders garbled.
+ * ORBIS_COMPUTE_BUFFER_OPS=1 gives copies and clears back to radeonsi's own choice, =copy or =clear only one
+ * kind; ORBIS_TRACE_BUFFER_OPS=1 logs the first 600 operations with their route and caller. */
+#define ORBIS_COMPUTE_COPY  1u
+#define ORBIS_COMPUTE_CLEAR 2u
+
+static unsigned orbis_compute_buffer_ops(void)
+{
+   static int ops = -1;
+   if (ops < 0) {
+      const char *env = getenv("ORBIS_COMPUTE_BUFFER_OPS");
+      ops = !env ? 0 : !strcmp(env, "1") ? (ORBIS_COMPUTE_COPY | ORBIS_COMPUTE_CLEAR)
+          : !strcmp(env, "copy") ? ORBIS_COMPUTE_COPY : !strcmp(env, "clear") ? ORBIS_COMPUTE_CLEAR : 0;
+   }
+   return ops;
+}
+
+static void orbis_trace_buffer_op(const char *op, const char *route, struct pipe_resource *dst,
+                                  uint64_t dst_offset, struct pipe_resource *src, uint64_t src_offset,
+                                  uint64_t size, void *caller)
+{
+   static int enabled = -1;
+   static unsigned count;
+   if (enabled < 0) {
+      const char *env = getenv("ORBIS_TRACE_BUFFER_OPS");
+      enabled = env && env[0] == '1';
+      if (enabled)
+         mesa_logi("orbis-bufop: tracing; si_copy_buffer is at %p (callers are absolute addresses)",
+                   (void *)si_copy_buffer);
+   }
+   if (!enabled || count >= 600)
+      return;
+   struct si_resource *d = si_resource(dst), *s = src ? si_resource(src) : NULL;
+   mesa_logi("orbis-bufop %u %s via %s size=%" PRIu64 " dst=%p+%" PRIu64 " (bo %" PRIu64 " dom 0x%x flags 0x%x "
+             "bind 0x%x usage %u) src=%p+%" PRIu64 " (bo %" PRIu64 " dom 0x%x bind 0x%x usage %u) caller=%p",
+             ++count, op, route, size, (void *)d, dst_offset, d->bo_size, d->domains, d->flags, d->bind_history,
+             dst->usage, (void *)s, src_offset, s ? s->bo_size : 0, s ? s->domains : 0,
+             s ? s->bind_history : 0, src ? src->usage : 0, caller);
+}
+
+/* ORBIS_CHECK_CLEARS=1: after each of the first six clears of 256 bytes or more, end the batch, wait for the
+ * GPU, and read the buffer from memory with the CPU (the winsys mapping, not a GPU copy, which would read L2):
+ * how many words do not hold the clear value, and which 256-byte chunks they are in. Slow; diagnostic only. */
+static void orbis_check_clear(struct si_context *sctx, struct pipe_resource *dst, uint64_t offset,
+                              uint64_t size, uint32_t value, const char *route)
+{
+   static int enabled = -1;
+   static unsigned count;
+   if (enabled < 0) {
+      const char *env = getenv("ORBIS_CHECK_CLEARS");
+      enabled = env && env[0] == '1';
+   }
+   if (!enabled || count >= 6 || size < 256)
+      return;
+   count++;
+
+   struct pipe_fence_handle *fence = NULL;
+   sctx->b.flush(&sctx->b, &fence, 0);
+   if (fence) {
+      sctx->b.screen->fence_finish(sctx->b.screen, NULL, fence, OS_TIMEOUT_INFINITE);
+      sctx->b.screen->fence_reference(sctx->b.screen, &fence, NULL);
+   }
+   struct si_resource *res = si_resource(dst);
+   const uint8_t *base = sctx->ws->buffer_map(sctx->ws, res->buf, NULL,
+                                              PIPE_MAP_READ | PIPE_MAP_UNSYNCHRONIZED);
+   if (!base) {
+      mesa_logi("orbis-check %u: %s clear of %" PRIu64 " bytes - the buffer could not be mapped", count, route, size);
+      return;
+   }
+   const uint32_t *words = (const uint32_t *)(base + offset);
+   unsigned bad = 0, chunks = size / 256;
+   char map[129] = {0};
+   for (unsigned c = 0; c < chunks; c++) {
+      bool chunk_bad = false;
+      for (unsigned i = 0; i < 64; i++) {
+         if (words[c * 64 + i] != value) {
+            bad++;
+            chunk_bad = true;
+         }
+      }
+      if (c < 128)
+         map[c] = chunk_bad ? '1' : '0';
+   }
+   mesa_logi("orbis-check %u: %s clear size=%" PRIu64 " (bo %" PRIu64 " dom 0x%x flags 0x%x) value=0x%08x "
+             "words_bad=%u/%" PRIu64 " first_word=0x%08x chunks256=%s", count, route, size, res->bo_size,
+             res->domains, res->flags, value, bad, size / 4, words[0], map);
+   sctx->ws->buffer_unmap(sctx->ws, res->buf);
+}
+
+#endif
+
 void si_copy_buffer(struct si_context *sctx, struct pipe_resource *dst, struct pipe_resource *src,
                     uint64_t dst_offset, uint64_t src_offset, unsigned size)
 {
    if (!size)
       return;
 
+#ifdef HAVE_ORBIS_PLATFORM
+   void *caller = __builtin_return_address(0);
+   if (!(orbis_compute_buffer_ops() & ORBIS_COMPUTE_COPY)) {
+      orbis_trace_buffer_op("copy", "cpdma", dst, dst_offset, src, src_offset, size, caller);
+      si_cp_dma_copy_buffer(sctx, dst, src, dst_offset, src_offset, size);
+      return;
+   }
+#endif
+
    if (si_compute_clear_copy_buffer(sctx, dst, dst_offset, src, src_offset, size, NULL, 0, 0,
-                                    false, true))
+                                    false, true)) {
+#ifdef HAVE_ORBIS_PLATFORM
+      orbis_trace_buffer_op("copy", "compute", dst, dst_offset, src, src_offset, size, caller);
+#endif
       return;
+   }
 
+#ifdef HAVE_ORBIS_PLATFORM
+   orbis_trace_buffer_op("copy", "cpdma-auto", dst, dst_offset, src, src_offset, size, caller);
+#endif
    si_cp_dma_copy_buffer(sctx, dst, src, dst_offset, src_offset, size);
 }
 
@@ -825,10 +936,33 @@ void si_clear_buffer(struct si_context *sctx, struct pipe_resource *dst,
    if (util_lower_clearsize_to_dword(clear_value, (int*)&clear_value_size, &clamped))
       clear_value = &clamped;
 
+#ifdef HAVE_ORBIS_PLATFORM
+   /* CP DMA whenever it can do the clear - see orbis_compute_buffer_ops. Only unaligned clears and
+    * conditional ones still need compute. */
+   void *caller = __builtin_return_address(0);
+   if (!(orbis_compute_buffer_ops() & ORBIS_COMPUTE_CLEAR) && offset % 4 == 0 && size % 4 == 0 &&
+       clear_value_size == 4 && !render_condition_enable) {
+      orbis_trace_buffer_op("clear", "cpdma", dst, offset, NULL, 0, size, caller);
+      si_cp_dma_clear_buffer(sctx, &sctx->gfx_cs, dst, offset, size, *clear_value);
+      orbis_check_clear(sctx, dst, offset, size, *clear_value, "cpdma");
+      return;
+   }
+#endif
+
    if (si_compute_clear_copy_buffer(sctx, dst, offset, NULL, 0, size, clear_value,
                                     clear_value_size, 0, render_condition_enable,
-                                    method == SI_AUTO_SELECT_CLEAR_METHOD))
+                                    method == SI_AUTO_SELECT_CLEAR_METHOD)) {
+#ifdef HAVE_ORBIS_PLATFORM
+      orbis_trace_buffer_op("clear", "compute", dst, offset, NULL, 0, size, caller);
+      if (clear_value_size == 4 && offset % 4 == 0 && size % 4 == 0)
+         orbis_check_clear(sctx, dst, offset, size, *clear_value, "compute");
+#endif
       return;
+   }
+
+#ifdef HAVE_ORBIS_PLATFORM
+   orbis_trace_buffer_op("clear", "cpdma-auto", dst, offset, NULL, 0, size, caller);
+#endif
 
    /* Compute handles all unaligned sizes, so this is always aligned. */
    assert(offset % 4 == 0 && size % 4 == 0 && clear_value_size == 4);
