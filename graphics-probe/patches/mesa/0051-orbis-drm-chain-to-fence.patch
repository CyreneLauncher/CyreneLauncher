+/* Chain-to-fence construction, shared by the host tests and both submit arms. */
+#define ORBIS_CHAIN_CHUNKS 16
+struct orbis_chain_node { uint32_t *ib; uint32_t dw; };
+struct orbis_chain_plan {
+   struct orbis_chain_node nodes[ORBIS_CHAIN_MAX_DEPTH];
+   unsigned count, tails[ORBIS_CHAIN_CHUNKS], chunks;
+   uint32_t saved[ORBIS_CHAIN_CHUNKS][4];
+   uint64_t total_dw;
+   const char *why;
+};
+
+/* Never dereference a packet-supplied address until its entire range is checked.
+ * The private slot is allowed only by the validator, not by RADV tail discovery. */
+static bool
+orbis_chain_range(uint64_t addr, uint32_t dw, const uint32_t *private_ib, uint32_t private_dw)
+{
+   const uint64_t bytes = (uint64_t)dw * 4;
+   const uint64_t own = (uint64_t)(uintptr_t)private_ib;
+   return dw != 0 && dw <= 0xfffffu && (addr & 3u) == 0 &&
+          ((addr >= orbis_va_base && addr < orbis_va_end && bytes <= orbis_va_end - addr) ||
+           (private_ib != NULL && addr >= own && addr - own < (uint64_t)private_dw * 4 &&
+            bytes <= (uint64_t)private_dw * 4 - (addr - own)));
+}
+
+static bool
+orbis_walk_chain(struct orbis_chain_plan *p, uint32_t *ib, uint32_t n,
+                 const uint32_t *private_ib, uint32_t private_dw)
+{
+   for (;;) {
+      const uint64_t addr = (uint64_t)(uintptr_t)ib;
+      if (!orbis_chain_range(addr, n, private_ib, private_dw)) {
+         p->why = "IB outside arena/private slot or invalid size";
+         return false;
+      }
+      if (p->count >= ORBIS_CHAIN_MAX_DEPTH) {
+         p->why = "chain depth limit";
+         return false;
+      }
+      /* A repeated or overlapping IB across chunks is also unsafe: one tail cannot
+       * jump to two different successors. Refuse before changing any memory. */
+      for (unsigned h = 0; h < p->count; h++) {
+         const uint64_t prev = (uint64_t)(uintptr_t)p->nodes[h].ib;
+         if (addr < prev + (uint64_t)p->nodes[h].dw * 4 && prev < addr + (uint64_t)n * 4) {
+            p->why = "repeated/overlapping IB";
+            return false;
+         }
+      }
+      p->nodes[p->count++] = (struct orbis_chain_node){ib, n};
+      p->total_dw += n;
+      bool chained = false;
+      for (uint32_t i = 0; i < n;) {
+         const uint32_t hdr = ib[i];
+         if ((hdr & 0xc0000000u) == 0x80000000u) {
+            ++i;
+            continue;
+         }
+         if ((hdr & 0xc0000000u) != 0xc0000000u) {
+            p->why = "non-packet before IB tail";
+            return false;
+         }
+         const uint32_t op = (hdr >> 8) & 0xffu;
+         const uint32_t words = 2 + ((hdr >> 16) & 0x3fffu);
+         /* RADV's padding sentinel does not hide an overwritten CHAIN behind it. */
+         if (hdr == 0xffff1000u) {
+            ++i;
+            continue;
+         }
+         if (words > n - i || (op == 0x3f && words != 4)) {
+            p->why = "malformed/truncated packet";
+            return false;
+         }
+         if (op == 0x3f && (ib[i + 3] & (1u << 20))) {
+            const uint64_t next = (uint64_t)ib[i + 1] | ((uint64_t)(ib[i + 2] & 0xffffu) << 32);
+            n = ib[i + 3] & 0xfffffu;
+            ib = (uint32_t *)(uintptr_t)next;
+            chained = true;
+            break; /* CHAIN does not return; all later dwords are dead. */
+         }
+         i += words;
+      }
+      if (!chained)
+         return true;
+   }
+}
+
+static bool
+orbis_prepare_chain(struct orbis_chain_plan *p, void **dcb, uint32_t *bytes, unsigned count)
+{
+   memset(p, 0, sizeof(*p));
+   if (count == 0 || count > ORBIS_CHAIN_CHUNKS) {
+      p->why = "invalid chunk count";
+      return false;
+   }
+   for (unsigned c = 0; c < count; c++) {
+      if ((bytes[c] & 3u) != 0 ||
+          !orbis_walk_chain(p, dcb[c], bytes[c] / 4, NULL, 0)) {
+         if (p->why == NULL)
+            p->why = "unaligned IB size";
+         return false;
+      }
+      const unsigned last = p->count - 1;
+      struct orbis_chain_node *node = &p->nodes[last];
+      /* The slot must be a packet boundary, not a NOP-looking value in a payload. */
+      uint32_t i = 0;
+      while (i < node->dw && node->dw - i > 4) {
+         const uint32_t hdr = node->ib[i];
+         uint32_t words = (hdr & 0xc0000000u) == 0x80000000u ? 1 : 2 + ((hdr >> 16) & 0x3fffu);
+         if (hdr == 0xffff1000u)
+            words = 1;
+         i += words;
+      }
+      if (node->dw < 4 || i != node->dw - 4 || node->ib[i] != ORBIS_PM4_TYPE3(0x10, 3)) {
+         p->why = "final IB has no reserved NOP(2) tail slot";
+         return false;
+      }
+      p->tails[c] = last;
+      memcpy(p->saved[c], node->ib + i, sizeof(p->saved[c]));
+   }
+   /* Leave room in the bounded validator/hung list for the fence and optional init IB. */
+   if (p->count > ORBIS_CHAIN_MAX_DEPTH - 2) {
+      p->why = "chain depth leaves no room for fence";
+      return false;
+   }
+   p->chunks = count;
+   return true;
+}
+
+static void
+orbis_chain_jump(uint32_t *tail, const uint32_t *target, uint32_t dw)
+{
+   const uint64_t addr = (uint64_t)(uintptr_t)target;
+   tail[0] = ORBIS_PM4_TYPE3(0x3f, 3);
+   tail[1] = (uint32_t)addr;
+   tail[2] = (uint32_t)(addr >> 32);
+   tail[3] = (1u << 20) | (1u << 23) | dw; /* CHAIN, VALID; same fields as RADV. */
+}
+
+static void
+orbis_link_chain(struct orbis_chain_plan *p, void **dcb, uint32_t *bytes,
+                 uint32_t *fence, uint32_t fence_dw)
+{
+   for (unsigned c = 0; c < p->chunks; c++) {
+      struct orbis_chain_node *node = &p->nodes[p->tails[c]];
+      const uint32_t *next = c + 1 < p->chunks ? dcb[c + 1] : fence;
+      const uint32_t next_dw = c + 1 < p->chunks ? bytes[c + 1] / 4 : fence_dw;
+      orbis_chain_jump(node->ib + node->dw - 4, next, next_dw);
+   }
+}
+
+static void
+orbis_restore_chain(struct orbis_chain_plan *p)
+{
+   for (unsigned c = 0; c < p->chunks; c++) {
+      struct orbis_chain_node *node = &p->nodes[p->tails[c]];
+      memcpy(node->ib + node->dw - 4, p->saved[c], sizeof(p->saved[c]));
+   }
+}
+/* End chain-to-fence construction. */
