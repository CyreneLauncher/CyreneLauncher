+      region[half - 4] = ORBIS_PM4_TYPE3(0x10, 3);
+      region[2 * half - 4] = ORBIS_PM4_TYPE3(0x10, 3);
+      region[size - 4] = ORBIS_PM4_TYPE3(0x10, 3);
