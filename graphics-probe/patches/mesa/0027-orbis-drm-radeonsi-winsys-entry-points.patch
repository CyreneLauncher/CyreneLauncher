+
+bool
+ac_rtld_open(struct ac_rtld_binary *binary, struct ac_rtld_open_info i)
+{
+   return false;
+}
+
+void
+ac_rtld_close(struct ac_rtld_binary *binary)
+{
+}
+
+bool
+ac_rtld_get_section_by_name(struct ac_rtld_binary *binary, const char *name, const char **data, size_t *nbytes)
+{
+   return false;
+}
+
+int
+ac_rtld_upload(struct ac_rtld_upload_info *u)
+{
+   return -1;
+}
+#endif
