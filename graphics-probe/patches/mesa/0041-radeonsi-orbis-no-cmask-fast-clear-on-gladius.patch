diff --git a/src/gallium/drivers/radeonsi/si_clear.c b/src/gallium/drivers/radeonsi/si_clear.c
index 73bb30b..c803e6d 100644
--- a/src/gallium/drivers/radeonsi/si_clear.c
+++ b/src/gallium/drivers/radeonsi/si_clear.c
@@ -96,9 +96,27 @@ static bool si_alloc_separate_cmask(struct si_screen *sscreen, struct si_texture
    if (!tex->surface.cmask_size)
       return false;
 
+#ifdef HAVE_ORBIS_PLATFORM
+   /* ORBIS_CMASK_ADDR_TYPE=0|1|2 (with ORBIS_FAST_CLEAR=1): on Gladius, CB_COLOR_INFO.CMASK_ADDR_TYPE (bits 29-30:
+    * tiled, linear, TC-compatible), the field GFX8's colour block chooses its CMASK addressing by - Mesa sets it
+    * for TC-compatible CMASK. CMASK_IS_LINEAR (bit 19), the older field, made no difference to the half-lost
+    * tiles. Whether another mode needs more than the 8-pipe size computed here is unknown, so the buffer is
+    * allocated twice as large while this is set. ComputeProbe 2026-10-07: 1 and 2 both still lose half the tiles. */
+   int orbis_addr_type = -1;
+   if (sscreen->info.family == CHIP_GLADIUS) {
+      const char *env = getenv("ORBIS_CMASK_ADDR_TYPE");
+      if (env && env[0] >= '0' && env[0] <= '2' && env[1] == '\0')
+         orbis_addr_type = env[0] - '0';
+   }
+   tex->cmask_buffer =
+      si_aligned_buffer_create(&sscreen->b, PIPE_RESOURCE_FLAG_UNMAPPABLE, PIPE_USAGE_DEFAULT,
+                               tex->surface.cmask_size * (orbis_addr_type >= 0 ? 2 : 1),
+                               1 << tex->surface.cmask_alignment_log2);
+#else
    tex->cmask_buffer =
       si_aligned_buffer_create(&sscreen->b, PIPE_RESOURCE_FLAG_UNMAPPABLE, PIPE_USAGE_DEFAULT,
                                tex->surface.cmask_size, 1 << tex->surface.cmask_alignment_log2);
+#endif
    if (tex->cmask_buffer == NULL)
       return false;
 
@@ -107,6 +125,10 @@ static bool si_alloc_separate_cmask(struct si_screen *sscreen, struct si_texture
     */
    tex->cmask_base_address_reg = tex->cmask_buffer->gpu_address >> 8;
    tex->cb_color_info |= S_028C70_FAST_CLEAR(1);
+#ifdef HAVE_ORBIS_PLATFORM
+   if (orbis_addr_type >= 0)
+      tex->cb_color_info |= S_028C70_CMASK_ADDR_TYPE(orbis_addr_type);
+#endif
 
    p_atomic_inc(&sscreen->compressed_colortex_counter);
    return true;
@@ -507,6 +529,24 @@ static void si_fast_clear(struct si_context *sctx, unsigned *buffers,
    if (sctx->screen->debug_flags & (DBG(FORCE_GFX_BLIT) | DBG(FORCE_COMPUTE_BLIT)))
       return;
 
+#ifdef HAVE_ORBIS_PLATFORM
+   /* No CMASK fast clears on the PS4 Pro (Gladius), as no HTILE (NO_HYPERZ in si_pipe.c). After a fast clear
+    * and a draw over part of the target, exactly half of the drawn 8x8 tiles came back as the clear colour, in
+    * an address-interleaved pattern, at every size from 1024 wide up - whether the CMASK was cleared by
+    * compute or CP DMA (Minecraft's Mojang loading logo). Sony runs the Pro's metadata with a different pipe
+    * configuration (18 for HTILE); CMASK's addressing presumably differs the same way. Until it is derived,
+    * colour clears write the pixels. ORBIS_FAST_CLEAR=1 allows fast clears again, to work on that. */
+   if (sctx->screen->info.family == CHIP_GLADIUS) {
+      static int allowed = -1;
+      if (allowed < 0) {
+         const char *env = getenv("ORBIS_FAST_CLEAR");
+         allowed = env && env[0] == '1' && env[1] == '\0';
+      }
+      if (!allowed)
+         return;
+   }
+#endif
+
    /* Gather information about what to clear. */
    unsigned color_buffer_mask = (*buffers & PIPE_CLEAR_COLOR) >> util_logbase2(PIPE_CLEAR_COLOR0);
    while (color_buffer_mask) {
@@ -695,6 +735,11 @@ static void si_fast_clear(struct si_context *sctx, unsigned *buffers,
             /* GFX6-8: This only covers mipmap level 0. */
             cmask_offset = tex->surface.cmask_offset;
             clear_size = tex->surface.cmask_size;
+#ifdef HAVE_ORBIS_PLATFORM
+            /* The whole separate CMASK, including the ORBIS_CMASK_ADDR_TYPE padding (si_alloc_separate_cmask). */
+            if (sctx->screen->info.family == CHIP_GLADIUS && tex->cmask_buffer != &tex->buffer)
+               clear_size = tex->cmask_buffer->b.b.width0 - cmask_offset;
+#endif
          }
 
          /* Do the fast clear. */
