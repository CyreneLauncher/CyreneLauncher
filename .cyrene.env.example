# Copy to .cyrene.env and set your compatible SDK and host tool paths.
ORBIS_SDK=/path/to/ps4-payload-sdk
PS4_TOOLCHAIN=/path/to/PS4Toolchain
BOOT_JDK17=/path/to/host-jdk17
BOOT_JDK21=/path/to/host-jdk21
BOOT_JDK25=/path/to/host-jdk25
PKGTOOL=/path/to/PkgTool.Core.dll
# Configure the launcher application registration in secrets.env or GitHub Secrets.
